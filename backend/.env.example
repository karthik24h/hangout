DATABASE_URL=postgresql://hangout:replace-me@localhost:5432/hangout
PORT=5000
FRONTEND_URL=http://localhost:3000
# Optional additional browser origins (comma-separated).
ADDITIONAL_FRONTEND_ORIGINS=http://localhost:3001

# Media storage and per-user upload limits.
# Files are stored outside PostgreSQL. Use an absolute path in production.
MEDIA_STORAGE_DIR=./storage/media
MEDIA_MAX_FILE_BYTES=5368709120
MEDIA_MAX_USER_BYTES=21474836480
MEDIA_MAX_USER_ITEMS=20
MEDIA_MAX_DURATION_SECONDS=14400
